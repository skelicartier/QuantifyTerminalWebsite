{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/connect",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/company",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/documentation",
      "destination": "/vision",
      "permanent": true
    },
    {
      "source": "/application",
      "destination": "/careers",
      "permanent": false
    },
    {
      "source": "/changelog",
      "destination": "/product",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/deck",
      "destination": "/quantify-terminal-investor-deck.pdf"
    }
  ],
  "headers": [
    {
      "source": "/deck",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Quantify Terminal - Investor Deck - November 2026.pdf\""
        }
      ]
    },
    {
      "source": "/quantify-terminal-investor-deck.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Quantify Terminal - Investor Deck - November 2026.pdf\""
        }
      ]
    },
    {
      "source": "/yc-application",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/Public/video/quantify-terminal-yc-application.mp4",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/Public/video/quantify-terminal-yc-application-poster.jpg",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/Public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
